# ==============================================================================
# Wedding Invitation — Environment Configuration Template
# Sao chép file này sang ~/.config/wedding-invitation/.env (khuyến nghị, chmod 600)
# hoặc .env tại thư mục gốc dự án (đã được .gitignore chặn đẩy lên Git).
# ==============================================================================

# Địa chỉ & cổng lắng nghe nội bộ (chỉ bind loopback để đi qua Nginx + Cloudflare)
HOST=127.0.0.1
PORT=3008

# Domain công khai của thiệp cưới (dùng cho Origin check & link trong thông báo Telegram)
PUBLIC_ORIGIN=https://wedding.nhotin.space

# Băm scrypt mật khẩu đăng nhập trang /admin (tạo bằng: node scripts/set-admin-password.js)
ADMIN_PASSWORD_HASH=

# Token API bí mật tùy chọn cho truy cập CLI (tạo bằng: openssl rand -hex 32)
ADMIN_API_TOKEN=

# Khóa phiên nội bộ (tạo bằng: openssl rand -hex 32)
SESSION_SECRET=

# Thông báo Telegram khi khách đồng ý tham dự RSVP hoặc gửi lời chúc mới
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Đặt true nếu muốn nhận thông báo cả khi khách chọn "Báo bận"
TELEGRAM_NOTIFY_DECLINED=false
